  {
    "type": "function",
    "function": {
      "name": "canvas_test",
      "description": "Interact with the current artifact and check exact observable results. At least one assertion. Saves real receipt.",
      "parameters": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "click",
                    "fill"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "expectText": {
                  "type": "string"
                },
                "expectValue": {
                  "type": "string"
                },
                "expectCount": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "selector"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "expectText"
                  ]
                },
                {
                  "required": [
                    "expectValue"
                  ]
                },
                {
                  "required": [
                    "expectCount"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
