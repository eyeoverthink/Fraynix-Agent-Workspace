  {
    "type": "function",
    "function": {
      "name": "canvas_write",
      "description": "Create or revise a real runnable web artifact. index.html required. Existing artifact requires expectedVersion. Opens live preview.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "properties": {
              "index.html": {
                "type": "string",
                "minLength": 30
              }
            },
            "required": [
              "index.html"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "title",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
