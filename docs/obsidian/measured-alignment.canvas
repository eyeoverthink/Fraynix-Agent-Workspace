    {
      "id": "registration",
      "type": "text",
      "text": "Measured frame alignment\nPlanar similarity, separate withheld grid and tape checks, explicit native basis.\nverified",
      "x": 0,
      "y": 320,
      "width": 420,
      "height": 230
    },
    {
      "id": "appearance",
      "type": "text",
      "text": "Fixed appearance and negatives\nHuman-seeded colour/edge features and background margins; no semantic identity.\nverified",
      "x": 470,
      "y": 320,
      "width": 420,
      "height": 230
    },
    {
      "id": "store",
      "type": "text",
      "text": "Originals and source fences\nPrivate originals, exact replay, generations, manual phase boundaries and native ownership checks.\nverified",
      "x": 940,
      "y": 320,
      "width": 420,
      "height": 230
    },
    {
      "id": "windows",
      "type": "text",
      "text": "Independent physical evaluation\nFixed first windows and immutable first outcome; visibility must match originals.\nverified",
      "x": 1410,
      "y": 320,
      "width": 420,
      "height": 230
    },
    {
      "id": "view",
      "type": "text",
      "text": "Integrated measured view\nCamera/reference setup, user-paced phases and four derived native diagnostics.\nverified",
      "x": 0,
      "y": 610,
      "width": 420,
      "height": 230
    },
    {
      "id": "chat",
      "type": "text",
      "text": "Chat knows its current source\nTyped pinned numeric read/report, bounded model context, user-owned capture.\nverified",
      "x": 470,
      "y": 610,
      "width": 420,
      "height": 230
    },
    {
      "id": "export",
      "type": "text",
      "text": "Reports and independent export\nReal checked report, CSV, compressed snapshot and standalone verifier.\nverified",
      "x": 940,
      "y": 610,
      "width": 420,
      "height": 230
    },
    {
      "id": "next",
      "type": "text",
      "text": "Throughput and held-out cases\nProfile replay/guards/views, preserve exact results, then evaluate new motion and occlusion cases.\nplanned",
      "x": 1410,
      "y": 610,
      "width": 420,
      "height": 230
    }
