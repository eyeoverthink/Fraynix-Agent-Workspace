    "contents": {
      "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\"/>\n<title>Created workspace app</title>\n<style>\nbody{font-family:sans-serif;background:#f0f2f5;margin:0;padding:20px;display:flex;justify-content:center;align-items:center;height:100vh}\n#app{background:white;border-radius:8px;padding:30px 40px;box-shadow:0 4px 12px rgba(0,0,0,.1);text-align:center;width:280px}\n#value{font-size:2rem;margin:20px 0;padding:10px;width:100%;border:2px solid #ddd;border-radius:6px;text-align:center;background:#fafafa;pointer-events:none}\nbutton{font-size:1rem;padding:10px 20px;margin:5px;border:none;border-radius:4px;background:#007bff;color:white;cursor:pointer;transition:.3s}\nbutton:hover{background:#0056b3}\n</style>\n</head>\n<body>\n<div id=\"app\">\n<h2>Experiment Counter</h2>\n<input type=\"text\" id=\"value\" value=\"0\" readonly/>\n<button id=\"up\">Up</button>\n<button id=\"reset\">Reset</button>\n</div>\n<script>\nconst valueEl=document.getElementById('value');\nconst upBtn=document.getElementById('up');\nconst resetBtn=document.getElementById('reset');\nfunction updateDisplay(num){valueEl.value=num.toString();}\nlet counter=0;\nupdateDisplay(counter);\nupBtn.addEventListener('click',()=>{counter++;updateDisplay(counter);});\nresetBtn.addEventListener('click',()=>{counter=0;updateDisplay(counter);});\n</script>\n</body>\n</html>"
